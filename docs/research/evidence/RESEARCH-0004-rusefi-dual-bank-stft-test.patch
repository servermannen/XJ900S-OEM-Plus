 #include "closed_loop_fuel_cell.h"
 #include "closed_loop_fuel.h"
+#include "injector_model.h"
+#include "main_trigger_callback.h"
 
 using ::testing::_;
 using ::testing::Return;
@@ -97,3 +99,159 @@ TEST(ClosedLoopFuel, afrLimits) {
 	Sensor::setMockValue(SensorType::Lambda1, 2.0f);
 	EXPECT_NE(stft.getLearningState(SensorType::Lambda1), stftEnabled);
 }
+
+TEST(ClosedLoopFuel, DualBankSequentialPhysicalCylinderMapping) {
+	StrictMock<MockExecutor> mockExecutor;
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	setupSimpleTestEngineWithMafAndTT_ONE_trigger(&eth, IM_SEQUENTIAL);
+	EXPECT_CALL(*eth.mockAirmass, getAirmass(_, _))
+		.WillRepeatedly(Return(AirmassResult{1.0f, 50.0f}));
+
+	engineConfiguration->cylindersCount = 4;
+	engineConfiguration->firingOrder = FO_1_3_4_2;
+	engineConfiguration->injectionMode = IM_SEQUENTIAL;
+	engineConfiguration->isInjectionEnabled = true;
+	engineConfiguration->isIgnitionEnabled = true;
+	engineConfiguration->enableStagedInjection = false;
+	engineConfiguration->coastingFuelCutEnabled = false;
+	engineConfiguration->fuelClosedLoopCorrectionEnabled = true;
+	engineConfiguration->noFuelTrimAfterDfcoTime = 1;
+	engineConfiguration->noFuelTrimAfterAccelTime = 1;
+	engineConfiguration->wwaeTau = 0;
+	engineConfiguration->wwaeBeta = 0;
+
+	constexpr uint8_t expectedPhysicalBank[] = {0, 0, 1, 1};
+	for (size_t physicalCylinder = 0; physicalCylinder < 4; physicalCylinder++) {
+		engineConfiguration->cylinderBankSelect[physicalCylinder] = expectedPhysicalBank[physicalCylinder];
+	}
+
+	auto& stftConfig = engineConfiguration->stft;
+	stftConfig.startupDelay = 1;
+	stftConfig.minClt = 60;
+	stftConfig.minAfr = 10;
+	stftConfig.maxAfr = 20;
+	stftConfig.deadband = 0;
+	for (auto& cellConfig : stftConfig.cellCfgs) {
+		cellConfig.timeConstant = 0.1f;
+		cellConfig.maxAdd = 20;
+		cellConfig.maxRemove = 20;
+	}
+	engine->module<ShortTermFuelTrim>()->init(&stftConfig);
+
+	setTable(config->lambdaTable, 1.0f);
+	Sensor::setMockValue(SensorType::Clt, 80.0f);
+	Sensor::setMockValue(SensorType::Tps1, 20.0f);
+	Sensor::setMockValue(SensorType::Map, 50.0f);
+	Sensor::setMockValue(SensorType::BatteryVoltage, 14.0f);
+	constexpr float lambda1 = 1.1f;
+	constexpr float lambda2 = 0.9f;
+	Sensor::setMockValue(SensorType::Lambda1, lambda1);
+	Sensor::setMockValue(SensorType::Lambda2, lambda2);
+
+	engine->rpmCalculator.setRpmValue(2000);
+	setTimeNowUs(10'000'000);
+
+	constexpr size_t integrationCallbacks = 10;
+	for (size_t i = 0; i < integrationCallbacks; i++) {
+		engine->periodicFastCallback();
+	}
+
+	auto& state = engine->engineState;
+	const float bank0Correction = state.stftCorrection[0];
+	const float bank1Correction = state.stftCorrection[1];
+	EXPECT_GE(engine->fuelComputer.running.timeSinceCrankingInSecs, stftConfig.startupDelay);
+	EXPECT_GE(engine->module<DfcoController>()->getTimeSinceCut(),
+		engineConfiguration->noFuelTrimAfterDfcoTime);
+	EXPECT_GE(engine->module<TpsAccelEnrichment>()->getTimeSinceAcell(),
+		engineConfiguration->noFuelTrimAfterAccelTime);
+	EXPECT_GE(engine->module<LimpManager>()->getTimeSinceAnyCut(), 2.0f);
+	EXPECT_TRUE(engine->module<LimpManager>()->allowInjection());
+	ASSERT_EQ(stftEnabled, engine->module<ShortTermFuelTrim>()->stftCorrectionState);
+	ASSERT_EQ(stftEnabled, engine->module<ShortTermFuelTrim>()->stftLearningState[0]);
+	ASSERT_EQ(stftEnabled, engine->module<ShortTermFuelTrim>()->stftLearningState[1]);
+	EXPECT_GT(bank0Correction, 1.0f);
+	EXPECT_LT(bank1Correction, 1.0f);
+	ASSERT_NE(bank0Correction, bank1Correction);
+
+	float injectionMass[4];
+	float injectorDuration[4];
+	const float untrimmedMass = state.injectionMass[0] / bank0Correction;
+	for (size_t physicalCylinder = 0; physicalCylinder < 4; physicalCylinder++) {
+		const uint8_t bank = expectedPhysicalBank[physicalCylinder];
+		EXPECT_EQ(bank, engineConfiguration->cylinderBankSelect[physicalCylinder]);
+		injectionMass[physicalCylinder] = state.injectionMass[physicalCylinder];
+		EXPECT_NEAR(untrimmedMass * state.stftCorrection[bank], injectionMass[physicalCylinder], EPS4D);
+		injectorDuration[physicalCylinder] =
+			engine->module<InjectorModelPrimary>()->getInjectionDuration(injectionMass[physicalCylinder]);
+	}
+	EXPECT_FLOAT_EQ(injectionMass[0], injectionMass[1]);
+	EXPECT_FLOAT_EQ(injectionMass[2], injectionMass[3]);
+	EXPECT_NE(injectionMass[0], injectionMass[2]);
+	EXPECT_FLOAT_EQ(injectorDuration[0], injectorDuration[1]);
+	EXPECT_FLOAT_EQ(injectorDuration[2], injectorDuration[3]);
+	EXPECT_NE(injectorDuration[0], injectorDuration[2]);
+
+	engine->injectionEvents.invalidate();
+	engine->injectionEvents.addFuelEvents();
+	ASSERT_TRUE(engine->injectionEvents.isReady);
+
+	constexpr size_t firingOrderPhysicalCylinder[] = {0, 2, 3, 1};
+	constexpr uint8_t firingOrderBank[] = {0, 1, 1, 0};
+	for (size_t firingPosition = 0; firingPosition < 4; firingPosition++) {
+		auto& event = engine->injectionEvents.elements[firingPosition];
+		const size_t physicalCylinder = firingOrderPhysicalCylinder[firingPosition];
+		ASSERT_NE(nullptr, event.outputs[0]);
+		EXPECT_EQ(static_cast<int>(physicalCylinder), static_cast<int>(event.outputs[0]->injectorIndex));
+		EXPECT_EQ(nullptr, event.outputs[1]);
+		EXPECT_EQ(firingOrderBank[firingPosition],
+			engineConfiguration->cylinderBankSelect[physicalCylinder]);
+	}
+
+	for (auto& event : engine->injectionEvents.elements) {
+		event.injectionStartAngle = 100;
+	}
+	engine->scheduler.setMockExecutor(&mockExecutor);
+
+	for (size_t firingPosition = 0; firingPosition < 4; firingPosition++) {
+		auto& event = engine->injectionEvents.elements[firingPosition];
+		const size_t physicalCylinder = firingOrderPhysicalCylinder[firingPosition];
+		constexpr float eventAngle = 5;
+		const efitick_t nowNt = US2NT(10'000'000 + 100'000 * firingPosition);
+		const efitick_t startTime = sumTickAndFloat(
+			nowNt, USF2NT(engine->rpmCalculator.oneDegreeUs * eventAngle));
+		const efitick_t endTime = startTime
+			+ US2NT(static_cast<int>(MS2US(injectorDuration[physicalCylinder])));
+
+		event.injectionStartAngle = eventAngle;
+		{
+			::testing::InSequence sequence;
+			EXPECT_CALL(mockExecutor, schedule(::testing::NotNull(), _, startTime,
+				::testing::Property(&action_s::getArgumentRaw,
+					::testing::Eq(reinterpret_cast<uintptr_t>(&event)))));
+			EXPECT_CALL(mockExecutor, schedule(::testing::NotNull(), _, endTime,
+				::testing::Property(&action_s::getArgumentRaw,
+					::testing::Eq(reinterpret_cast<uintptr_t>(&event)))));
+		}
+		engine->injectionEvents.onTriggerTooth(nowNt, 0, 10);
+		event.injectionStartAngle = 100;
+	}
+
+	printf("DualBankSTFT lambda1=%.3f lambda2=%.3f bank0=%.6f bank1=%.6f "
+		"mass=[%.8f,%.8f,%.8f,%.8f] duration_ms=[%.6f,%.6f,%.6f,%.6f] "
+		"firing_order_outputs=[1,3,4,2]\n",
+		lambda1, lambda2, bank0Correction, bank1Correction,
+		injectionMass[0], injectionMass[1], injectionMass[2], injectionMass[3],
+		injectorDuration[0], injectorDuration[1], injectorDuration[2], injectorDuration[3]);
+
+	const float learnedBank0Correction = state.stftCorrection[0];
+	const float learnedCylinder1Mass = state.injectionMass[0];
+	Sensor::setInvalidMockValue(SensorType::Lambda1);
+	engine->periodicFastCallback();
+	EXPECT_EQ(stftDisabledAfrOurOfRange,
+		engine->module<ShortTermFuelTrim>()->stftLearningState[0]);
+	EXPECT_FLOAT_EQ(learnedBank0Correction, state.stftCorrection[0]);
+	EXPECT_FLOAT_EQ(learnedCylinder1Mass, state.injectionMass[0]);
+	printf("DualBankSTFT invalid_lambda1 bank0_retained=%.6f cylinder1_mass_retained=%.8f\n",
+		state.stftCorrection[0], state.injectionMass[0]);
+}
